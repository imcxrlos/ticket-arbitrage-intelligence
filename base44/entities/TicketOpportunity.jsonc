{
  "name": "TicketOpportunity",
  "type": "object",
  "properties": {
    "match": {
      "type": "string",
      "description": "Match name e.g. Argentina vs Brazil"
    },
    "team_home": {
      "type": "string"
    },
    "team_away": {
      "type": "string"
    },
    "stadium": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "match_date": {
      "type": "string",
      "format": "date-time"
    },
    "category": {
      "type": "string",
      "enum": [
        "Category 1",
        "Category 2",
        "Category 3",
        "Category 4",
        "VIP",
        "Premium"
      ]
    },
    "signal_type": {
      "type": "string",
      "enum": [
        "Arbitrage",
        "Price Analysis"
      ],
      "description": "Arbitrage = real cross-market spread found. Price Analysis = single platform only."
    },
    "current_price": {
      "type": "number",
      "description": "Cheapest price found across all platforms"
    },
    "market_value": {
      "type": "number",
      "description": "Average price across all platforms (real market average)"
    },
    "highest_price": {
      "type": "number",
      "description": "Highest price found across all platforms"
    },
    "discount_pct": {
      "type": "number",
      "description": "Savings vs market average %"
    },
    "vs_highest_pct": {
      "type": "number",
      "description": "Savings vs most expensive platform %"
    },
    "opportunity_score": {
      "type": "number"
    },
    "source_url": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "description": "Best (cheapest) marketplace name"
    },
    "best_platform": {
      "type": "string"
    },
    "worst_platform": {
      "type": "string"
    },
    "platforms_compared": {
      "type": "number",
      "description": "Number of platforms with live data"
    },
    "market_summaries": {
      "type": "string",
      "description": "JSON string: array of {platform, min_price, avg_price, listing_count, url}"
    },
    "quantity_available": {
      "type": "number"
    },
    "demand_tier": {
      "type": "string",
      "enum": [
        "Ultra High",
        "High",
        "Medium",
        "Low"
      ]
    },
    "group": {
      "type": "string"
    },
    "round": {
      "type": "string",
      "enum": [
        "Group Stage",
        "Round of 32",
        "Round of 16",
        "Quarter-Final",
        "Semi-Final",
        "Third Place",
        "Final"
      ]
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "last_scanned": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "match",
    "stadium",
    "city",
    "current_price",
    "market_value"
  ]
}